# Citation recommendations (https://openalex.org/settings/api)
OPENALEX_API_KEY=

# Optional: Korean summaries. Without it, summaries are marked unavailable.
OPENCODE_GO_API_KEY=
OPENCODE_GO_TIMEOUT_MS=60000
OPENCODE_GO_MAX_RETRIES=3

# Optional: arXiv request resilience. Requests are always spaced by at least 3 seconds.
ARXIV_REQUEST_TIMEOUT_MS=60000
# Retries after the initial request; 0 disables retries.
ARXIV_MAX_RETRIES=4
ARXIV_RATE_LIMIT_RETRY_MS=30000
